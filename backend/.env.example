# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MySQL Database Options ──────────────────────────────────────────────────
# OPTION A: Single Connection URL (Recommended for Render, Railway, TiDB, Aiven, Supabase)
# DATABASE_URL=mysql://username:password@host:port/database?ssl=true

# OPTION B: Separate Host / Port / User / Password (Default for Local XAMPP or cPanel)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=incocom2k26
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_SSL=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=incocom_2k26_super_secure_random_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Admin Credentials (env-based login) ──────────────────────────────────────
ADMIN_EMAIL=mbamcaadmin@nprcet.org
ADMIN_PASSWORD=Incocom@2026

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
# Comma-separated allowed frontend origins in production (e.g. your Vercel/Netlify URL)
FRONTEND_URL=http://localhost:3000,https://incocom2k26.vercel.app
